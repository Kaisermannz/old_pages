---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout title="Inicio">
    <header style="padding: 30px 0 10px; display: flex; flex-direction: column; gap: 8px;">
        <div style="font-family: var(--font-pixel); font-size: 9px; color: var(--muted); letter-spacing: 2px;">
            SYS://KAISERMANN.SYS [ONLINE]
        </div>
        <h1 class="neon-orange" style="font-family: var(--font-pixel); font-size: 22px; line-height: 1.4; margin: 0;">
            KAISERMANN <span class="blink">_</span>
        </h1>
        <p style="color: var(--muted); font-size: 20px; margin: 0;">
            Bioinformática | Rust | Sistemas Linux | Hardware & IoT
        </p>
    </header>

    <div class="divider" style="margin: 24px 0 40px 0;"></div>

    <section>
        <h2 class="section-title neon-blue">>> SOBRE MÍ</h2>
        <div class="panel panel-blue">
            <p>
                Estudiante de 4to año de Ingeniería Civil en Bioinformática.
                Entusiasta de los servidores Linux, el hardware y la desconexión
                digital. Construyendo proyectos con Arduino y ESP32 (IoT).
            </p>
        </div>
    </section>

    <section style="margin-top: 60px;">
        <h2 class="section-title neon-orange">>> Proyectos</h2>

        <div style="display: grid; gap: 24px;">
            <ProjectCard
                titulo="SPEEDCUBING PWA"
                descripcion="Desarrollo de una aplicación web progresiva y cronómetro de precisión para competencias de speedcubing. Arquitectura limpia en Rust, SQLite, HTMX y PWA offline."
                tags={["Rust", "Axum", "SQLite", "HTMX", "Alpine.js", "PWA"]}
                url="/timer"
                linkText="VER CÓMO ESTÁ HECHO →"
                color="orange"
                icono="⏱️"
            />

            <ProjectCard
                titulo="THE WARDEN"
                descripcion="Monitor ambiental y sistema de arranque remoto para infraestructura de Home Lab."
                tags={["ESP32", "C++", "Telegram Bot API"]}
                color="blue"
                icono="⚡"
            />

            <ProjectCard
                titulo="NEEDLEMAN-WUNSCH"
                descripcion="Implementación nativa del algoritmo de alineamiento de secuencias bioinformáticas."
                tags={["C++", "Bioinformática", "Algoritmos", "graphviz"]}
                color="orange"
                icono="🧬"
            />
            <ProjectCard
                titulo="NAS"
                descripcion="NAS construido con un PC antiguo, alojando contenedores Docker."
                tags={[
                    "Portainer",
                    "Komga",
                    "Navidrome",
                    "Jdownloader",
                    "Tailscale",
                    "Samba",
                ]}
                color="orange"
                icono="☁️ 📁"
            />
        </div>
    </section>
</Layout>
